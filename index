<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Inglês do Zero</title>
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f7fa;--card:#fff;--ink:#14202e;--mute:#5b6b7c;--line:#d8e0e8;--acc:#0a7c86;--accw:#fff;--ok:#1d8a4e;--bad:#c0392b;--hl:#e3f3f4;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1720;--card:#18232f;--ink:#e8eef4;--mute:#9aabbb;--line:#2a3846;--acc:#3cc1cb;--accw:#06232a;--ok:#4cc27f;--bad:#ff7a6b;--hl:#183a40}}
:root[data-theme="dark"]{--bg:#0f1720;--card:#18232f;--ink:#e8eef4;--mute:#9aabbb;--line:#2a3846;--acc:#3cc1cb;--accw:#06232a;--ok:#4cc27f;--bad:#ff7a6b;--hl:#183a40}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.5 "Atkinson Hyperlegible",system-ui,sans-serif}
header{padding:20px 20px 8px;max-width:1000px;margin:auto;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
h1{margin:0;font-size:1.7rem;letter-spacing:-.02em}
h2{margin:0 0 4px;font-size:1.4rem}
.sub{color:var(--mute);margin:0;font-size:.95rem}
button{font:inherit;cursor:pointer;color:inherit}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.tog{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:8px 14px}
.tog[aria-pressed=true]{background:var(--acc);color:var(--accw);border-color:var(--acc)}
.wrap{max-width:1000px;margin:auto;padding:8px 20px 40px;display:grid;grid-template-columns:280px 1fr;gap:20px}
@media (max-width:760px){.wrap{grid-template-columns:1fr}}
nav{display:flex;flex-direction:column;gap:4px}
nav h3{margin:14px 0 4px;font-size:1rem;color:var(--mute);font-weight:700}
nav button{display:flex;justify-content:space-between;gap:8px;text-align:left;border:1px solid transparent;background:none;padding:10px 12px;border-radius:8px}
nav button:hover{background:var(--hl)}
nav button[aria-current=true]{background:var(--card);border-color:var(--acc);font-weight:700}
.stars{color:var(--acc);white-space:nowrap;letter-spacing:2px}
main{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:22px;min-height:420px}
.tip{background:var(--hl);border-left:4px solid var(--acc);padding:10px 14px;margin:14px 0;border-radius:0 8px 8px 0;font-size:.95rem}
.row{display:flex;align-items:center;gap:14px;padding:12px 0;border-top:1px solid var(--line)}
.sp{flex:none;width:46px;height:46px;border-radius:50%;border:2px solid var(--acc);background:none;color:var(--acc);font-size:1.1rem}
.sp:hover,.sp.on{background:var(--acc);color:var(--accw)}
.en{font-size:1.3rem;font-weight:700}
.pt{color:var(--mute);font-size:.95rem}
.pr{color:var(--acc);font-size:.95rem}
.btn{border:0;background:var(--acc);color:var(--accw);padding:12px 20px;border-radius:10px;font-weight:700}
.btn.alt{background:none;border:2px solid var(--acc);color:var(--acc)}
.bar{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}
.q{font-size:1.35rem;font-weight:700;margin:16px 0}
.opts{display:grid;gap:10px}
.opt{text-align:left;border:2px solid var(--line);background:var(--card);padding:14px;border-radius:10px;font-size:1.05rem}
.opt:hover:not(:disabled){border-color:var(--acc)}
.opt.ok{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 15%,var(--card))}
.opt.bad{border-color:var(--bad);background:color-mix(in srgb,var(--bad) 15%,var(--card))}
.fb{margin:14px 0;font-weight:700;min-height:1.5em}
.prog{height:8px;background:var(--line);border-radius:8px;overflow:hidden}
.prog i{display:block;height:100%;background:var(--acc);transition:width .3s}
.ans,.pool{display:flex;flex-wrap:wrap;gap:8px;min-height:56px;padding:10px;border:2px dashed var(--line);border-radius:10px;margin:10px 0}
.chip{border:2px solid var(--acc);background:var(--card);border-radin:8px;border-radius:8px;padding:8px 12px;font-size:1.05rem}
.big{font-size:2.4rem;margin:8px 0}
</style>
</head>
<body>
<header>
  <div><h1>Inglês do Zero</h1><p class="sub">Do "Hello" ao inglês avançado. Toque no alto-falante para ouvir.</p></div>
  <button class="tog" id="slow" aria-pressed="false">🐢 Voz lenta</button>
</header>
<div class="wrap">
  <nav id="nav" aria-label="Lições"></nav>
  <main id="main"></main>
</div>
<script>
// [inglês, português, pronúncia aproximada (opcional)]
const LV=['Básico','Intermediário','Avançado'];
const LS=[
{t:'Cumprimentos',lv:0,tip:'O "TH" (thank, three): ponha a ponta da língua entre os dentes e sopre de leve. Não é "t" nem "f".',i:[
['Hello','Olá','re-LÔU'],['Good morning','Bom dia','gud MÓR-nin'],['Good afternoon','Boa tarde','gud af-ter-NUN'],['Good night','Boa noite','gud NAIT'],['Goodbye','Tchau','gud-BÁI'],['Please','Por favor','PLIZ'],['Thank you','Obrigado(a)','THÉNK-iu'],['Sorry','Desculpa','SÓ-ri']]},
{t:'Eu sou, você é (verbo to be)',lv:0,tip:'"To be" = ser/estar. I am, you are, he/she/it is, we/you/they are. Em inglês o sujeito é obrigatório: nunca diga só "am happy".',i:[
['I am','Eu sou / estou','ai ÉM'],['You are','Você é / está','iu AR'],['He is','Ele é / está','rri IZ'],['She is','Ela é / está','chi IZ'],['We are','Nós somos','uí AR'],['They are','Eles são','dêi AR'],['My name is Luiz.','Meu nome é Luiz.','mai NÊIM iz Luiz'],['I am from Brazil.','Eu sou do Brasil.','ai ém from bra-ZÍL']]},
{t:'Números e cores',lv:0,tip:'O "R" inglês não vibra como o "rr" do português: a língua não encosta em lugar nenhum.',i:[
['One','Um','UÂN'],['Two','Dois','TU'],['Three','Três','THRI'],['Five','Cinco','FAIV'],['Ten','Dez','TÉN'],['Red','Vermelho','RÉD'],['Blue','Azul','BLU'],['Green','Verde','GRIN'],['Black','Preto','BLÉK'],['White','Branco','UÁIT']]},
{t:'Família e amigos',lv:0,tip:'Em mother, father e brother o "TH" é vibrado (língua entre os dentes, com voz).',i:[
['Mother','Mãe','MÂ-dhâr'],['Father','Pai','FÁ-dhâr'],['Brother','Irmão','BRÂ-dhâr'],['Sister','Irmã','SÍS-târ'],['Friend','Amigo(a)','FRÉND'],['This is my friend.','Este é meu amigo.','dhis iz mai frénd'],['My family is big.','Minha família é grande.','mai FÉ-mâ-li iz big']]},
{t:'Comida e pedidos',lv:0,tip:'"I would like..." é a forma educada de pedir. "I want..." soa seco.',i:[
['Water','Água','UÓ-târ'],['Coffee','Café','KÓ-fi'],['Bread','Pão','BRÉD'],['I want coffee.','Eu quero café.','ai uónt KÓ-fi'],['I would like some water.','Eu gostaria de água.','ai uud laik sâm UÓ-târ'],['How much is it?','Quanto custa?','rráu mâtch iz it'],['The bill, please.','A conta, por favor.','dhâ bil, pliz'],['Where is the bathroom?','Onde fica o banheiro?','uér iz dhâ BÉTH-rum']]},
{t:'Rotina (presente simples)',lv:1,tip:'Com he/she/it o verbo ganha -s: "She works". Nas negativas e perguntas use do/does: "He doesn\'t work", "Do you work?".',i:[
['I wake up at seven.','Eu acordo às sete.'],['I work every day.','Eu trabalho todo dia.'],['She drinks coffee in the morning.','Ela bebe café de manhã.'],['He doesn\'t like tea.','Ele não gosta de chá.'],['Do you speak English?','Você fala inglês?'],['I study English at night.','Eu estudo inglês à noite.'],['We usually eat at home.','Nós geralmente comemos em casa.']]},
{t:'Perguntas',lv:1,tip:'What (o quê), Where (onde), When (quando), Who (quem), Why (por quê), How (como). Vão no começo da frase.',i:[
['What is your name?','Qual é o seu nome?'],['Where do you live?','Onde você mora?'],['When does the class start?','Quando a aula começa?'],['Who is she?','Quem é ela?'],['Why are you late?','Por que você está atrasado?'],['How are you today?','Como você está hoje?'],['Can you help me?','Você pode me ajudar?']]},
{t:'Passado e futuro',lv:1,tip:'Passado: verbo + -ed (worked) ou irregular (go → went). Futuro: will + verbo, ou am/is/are going to + verbo. Negativa/pergunta no passado usa did + verbo base.',i:[
['I worked yesterday.','Eu trabalhei ontem.'],['She went to the market.','Ela foi ao mercado.'],['We didn\'t see the movie.','Nós não vimos o filme.'],['Did you eat lunch?','Você almoçou?'],['I will travel next month.','Eu vou viajar no mês que vem.'],['They are going to study tonight.','Eles vão estudar hoje à noite.'],['Tomorrow I will call you.','Amanhã eu ligo para você.']]},
{t:'Conversas reais',lv:2,tip:'Estas frases salvam qualquer conversa. Use "Could you repeat that?" sem medo: nativos pedem isso o tempo todo.',i:[
['Could you repeat that, please?','Pode repetir, por favor?'],['I\'m not sure I understand.','Não tenho certeza se entendi.'],['What do you do for a living?','O que você faz da vida (profissão)?'],['Let me think about it.','Deixa eu pensar sobre isso.'],['It depends on the situation.','Depende da situação.'],['I\'m looking forward to meeting you.','Estou ansioso para te conhecer.'],['I\'ve heard a lot about you.','Ouvi falar muito de você.']]},
{t:'Estruturas avançadas',lv:2,tip:'Present perfect (have + particípio) liga passado e presente. Condicional: if + passado, would + verbo. Treine ouvindo no modo lento e repetindo em voz alta.',i:[
['I have been learning English for three months.','Estou aprendendo inglês há três meses.'],['If I had more time, I would travel more.','Se eu tivesse mais tempo, viajaria mais.'],['She said that she was tired.','Ela disse que estava cansada.'],['I wish I could speak English fluently.','Queria poder falar inglês fluentemente.'],['Although it was raining, we went out.','Embora estivesse chovendo, nós saímos.'],['By the time you arrive, I will have finished.','Quando você chegar, eu já terei terminado.'],['You should have told me earlier.','Você deveria ter me contado antes.']]}
];

const $=s=>document.querySelector(s);
const shuf=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
let slow=false,cur=0,voices=[],prog={};
try{prog=JSON.parse(localStorage.getItem('eng')||'{}')}catch(e){}
const save=()=>{try{localStorage.setItem('eng',JSON.stringify(prog))}catch(e){}};

// ---- voz ----
const TTS='speechSynthesis' in window;
const loadV=()=>{voices=speechSynthesis.getVoices().filter(v=>v.lang.startsWith('en'))};
if(TTS){loadV();speechSynthesis.onvoiceschanged=loadV}
function say(t,btn){
  if(!TTS){alert('Seu navegador não tem voz. Tente o Chrome ou o Safari.');return}
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(t);u.lang='en-US';u.rate=slow?.55:.9;
  const v=voices.find(v=>v.lang==='en-US')||voices[0];if(v)u.voice=v;
  if(btn){btn.classList.add('on');u.onend=u.onerror=()=>btn.classList.remove('on')}
  speechSynthesis.speak(u);
}
$('#slow').onclick=e=>{slow=!slow;e.currentTarget.setAttribute('aria-pressed',slow)};

// ---- menu ----
function menu(){
  let h='';
  LV.forEach((n,l)=>{h+=`<h3>${n}</h3>`;LS.forEach((s,i)=>{if(s.lv!==l)return;
    const st=prog[i]||0;
    h+=`<button data-i="${i}" ${i===cur?'aria-current="true"':''}><span>${i+1}. ${s.t}</span><span class="stars" aria-label="${st} de 3 estrelas">${'★'.repeat(st)}${'☆'.repeat(3-st)}</span></button>`})});
  $('#nav').innerHTML=h;
  $('#nav').querySelectorAll('button').forEach(b=>b.onclick=()=>lesson(+b.dataset.i));
}

// ---- lição ----
function lesson(i){
  cur=i;menu();const L=LS[i];
  let h=`<h2>${i+1}. ${L.t}</h2><p class="sub">Nível ${LV[L.lv].toLowerCase()}</p><div class="tip">${L.tip}</div>
  <div class="bar"><button class="btn alt" id="all">▶ Ouvir tudo</button><button class="btn" id="go">Praticar (quiz)</button></div>`;
  L.i.forEach((it,n)=>{h+=`<div class="row"><button class="sp" data-n="${n}" aria-label="Ouvir ${it[0]}">🔊</button><div><div class="en">${it[0]}</div><div class="pt">${it[1]}</div>${it[2]?`<div class="pr">Soa como: ${it[2]}</div>`:''}</div></div>`});
  $('#main').innerHTML=h;
  document.querySelectorAll('.sp').forEach(b=>b.onclick=()=>say(L.i[b.dataset.n][0],b));
  $('#go').onclick=quiz;
  $('#all').onclick=()=>{if(!TTS)return;speechSynthesis.cancel();L.i.forEach(it=>{const u=new SpeechSynthesisUtterance(it[0]);u.lang='en-US';u.rate=slow?.55:.9;const v=voices.find(v=>v.lang==='en-US')||voices[0];if(v)u.voice=v;speechSynthesis.speak(u)})};
  window.scrollTo({top:0});
}

// ---- quiz ----
let qs=[],qi=0,score=0;
function opts(it,idx){
  const L=LS[cur];let pool=L.i.filter(x=>x!==it).map(x=>x[idx]);
  if(pool.length<3)pool=pool.concat(LS.flatMap(s=>s.i).filter(x=>x!==it).map(x=>x[idx]));
  pool=[...new Set(pool)].filter(x=>x!==it[idx]);
  return shuf([it[idx],...shuf(pool).slice(0,3)]);
}
function quiz(){
  const L=LS[cur];
  qs=shuf(L.i).slice(0,6).map((it,n)=>{
    const t=n%3;
    if(t===0)return{k:'listen',it,o:opts(it,1)};
    if(t===1)return{k:'pt2en',it,o:opts(it,0)};
    return it[0].split(' ').length>=3?{k:'order',it}:{k:'en2pt',it,o:opts(it,1)};
  });
  qi=0;score=0;ask();
}
function ask(){
  if(qi>=qs.length)return end();
  const q=qs[qi],it=q.it;
  let h=`<div class="prog" role="progressbar" aria-valuemax="${qs.length}" aria-valuenow="${qi}"><i style="width:${qi/qs.length*100}%"></i></div>`;
  if(q.k==='listen')h+=`<div class="q">Ouça e escolha o significado</div><button class="btn alt" id="rep">🔊 Ouvir de novo</button>`;
  if(q.k==='pt2en')h+=`<div class="q">Como se diz: “${it[1]}”?</div>`;
  if(q.k==='en2pt')h+=`<div class="q">O que significa “${it[0]}”?</div><button class="btn alt" id="rep">🔊 Ouvir</button>`;
  if(q.k==='order')h+=`<div class="q">Monte a frase: “${it[1]}”</div><div class="ans" id="ans" aria-label="Sua frase"></div><div class="pool" id="pool"></div><button class="btn" id="chk">Conferir</button>`;
  else h+=`<div class="opts">${q.o.map(o=>`<button class="opt">${o}</button>`).join('')}</div>`;
  h+=`<div class="fb" id="fb" aria-live="polite"></div><button class="btn" id="nx" hidden>Continuar</button>`;
  $('#main').innerHTML=h;
  if(q.k==='listen'||q.k==='en2pt'){const r=$('#rep');r.onclick=()=>say(it[0],r);if(q.k==='listen')setTimeout(()=>say(it[0]),250)}
  $('#nx').onclick=()=>{qi++;ask()};
  if(q.k==='order')return order(q);
  const right=q.k==='pt2en'?it[0]:it[1];
  document.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{
    const ok=b.textContent===right;
    document.querySelectorAll('.opt').forEach(x=>{x.disabled=true;if(x.textContent===right)x.classList.add('ok')});
    if(!ok)b.classList.add('bad');else score++;
    done(ok,it);
  });
}
function order(q){
  const it=q.it,words=it[0].split(' ');let pool=shuf(words.map((w,i)=>({w,i}))),ans=[];
  const draw=()=>{
    $('#ans').innerHTML='';$('#pool').innerHTML='';
    ans.forEach(o=>{const b=document.createElement('button');b.className='chip';b.textContent=o.w;b.onclick=()=>{ans=ans.filter(x=>x!==o);pool.push(o);draw()};$('#ans').append(b)});
    pool.forEach(o=>{const b=document.createElement('button');b.className='chip';b.textContent=o.w;b.onclick=()=>{pool=pool.filter(x=>x!==o);ans.push(o);draw()};$('#pool').append(b)});
  };
  draw();
  $('#chk').onclick=()=>{
    const ok=ans.map(o=>o.w).join(' ')===it[0];
    if(ok)score++;
    $('#chk').hidden=true;done(ok,it);
  };
}
function done(ok,it){
  $('#fb').innerHTML=ok?`<span style="color:var(--ok)">✔ Correto!</span>`:`<span style="color:var(--bad)">✘ Resposta: ${it[0]} = ${it[1]}</span>`;
  say(it[0]);$('#nx').hidden=false;$('#nx').focus();
}
function end(){
  const n=qs.length,st=score===n?3:score>=n-2?2:score>=n/2?1:0;
  if(st>(prog[cur]||0)){prog[cur]=st;save()}
  menu();
  const next=cur+1<LS.length;
  $('#main').innerHTML=`<h2>Resultado</h2><div class="big stars">${'★'.repeat(st)}${'☆'.repeat(3-st)}</div><p>Você acertou ${score} de ${n}.</p><p class="sub">${st===3?'Perfeito! Pode avançar.':st>=1?'Bom! Ouça de novo e tente tirar 3 estrelas.':'Sem problema: releia a lição, ouça no modo lento e tente de novo.'}</p>
  <div class="bar"><button class="btn alt" id="rv">Rever lição</button><button class="btn" id="rt">Refazer quiz</button>${next?'<button class="btn alt" id="nl">Próxima lição →</button>':''}</div>`;
  $('#rv').onclick=()=>lesson(cur);$('#rt').onclick=quiz;if(next)$('#nl').onclick=()=>lesson(cur+1);
}
lesson(0);
</script>
</body>
</html>
